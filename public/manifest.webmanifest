{
  "name": "Pigeon — Mobile Remote",
  "short_name": "Pigeon",
  "description": "Mobile Remote for Herdr Coding Agents",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay"
  ],
  "orientation": "portrait-primary",
  "background_color": "#282828",
  "theme_color": "#282828",
  "categories": [
    "developer",
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}